[Desktop Entry]
Type=Application
Name=OpenCode
Comment=AI coding agent
Exec=/usr/bin/konsole --qwindowtitle OpenCode --qwindowicon opencode --workdir /home/ubuntu -e /usr/local/bin/opencode
Path=/home/ubuntu
Icon=opencode
Terminal=false
Categories=Development;
Keywords=ai;coding;agent;terminal;
StartupNotify=true
