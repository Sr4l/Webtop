{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/opt/**": "allow",
      "/tmp/**": "allow",
      "/usr/**": "allow"
    }
  },
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--enable-scripting",
        "--enable-privileged-context",
        "--connect-existing"
      ],
      "enabled": true,
      "timeout": 65536
    }
  },
  "provider": {
    "chatai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ChatAi",
      "options": {
        "baseURL": "https://chat-ai.academiccloud.de/v1"
      },
      "models": {
        "qwen3.5-397b-a17b": {
          "name": "Qwen3.5 397b a17b",
          "cost": {
            "input": 0.39,
            "output": 2.45
          },
          "modalities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B",
          "cost": {
            "input": 0.26,
            "output": 2.08
          },
