            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "glm-5.3-flash" : {
          "name": "GLM 5.3-flash",
          "cost": {
            "input": 0.075,
            "output": 0.25
          },
          "modalities": {
            "tools": true,
            "input": ["text","image","video"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "qwen3.6-35b-a3b" : {
          "name": "Qwen 3.6 35B A3B",
          "cost": {
            "input": 0.10,
            "output": 0.95
          },
