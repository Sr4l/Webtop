{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/opt/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/**", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "firefox-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mozilla/firefox-devtools-mcp@latest",
          "--enable-scripting",
          "--enable-privileged-context",
          "--connect-existing"
        ],
        "timeout": {
          "catalog": 65536,
          "execution": 65536
        }
      }
    }
  },
  "providers": {
    "chatai": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "ChatAi",
      "settings": {
        "baseURL": "https://chat-ai.academiccloud.de/v1"
      },
      "models": {
        "qwen3.5-397b-a17b": {
          "name": "Qwen3.5 397b a17b",
          "cost": {
            "input": 0.39,
            "output": 2.45
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B",
          "cost": {
            "input": 0.26,
            "output": 2.08
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "glm-5.3-flash" : {
          "name": "GLM 5.3-flash",
          "cost": {
            "input": 0.075,
            "output": 0.25
          },
          "capabilities": {
            "tools": true,
            "input": ["text","image","video"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "qwen3.6-35b-a3b" : {
          "name": "Qwen 3.6 35B A3B",
          "cost": {
            "input": 0.10,
            "output": 0.95
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "qwen3.8-27b" : {
          "name": "Qwen 3.8 27B",
          "cost": {
            "input": 0.35,
            "output": 2.75
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 65536
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "Deepseek-v4-flash-0731",
          "cost": {
            "input": 0.09,
            "output": 0.18
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 300000
          }
        },
        "openai-gpt-oss-120b": {
          "name": "OpenAI GPT OSS 120b",
          "cost": {
            "input": 0.03,
            "output": 0.17
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 131072
          }
        },
        "gemma-4-31b-it" : {
          "name": "Gemma 4 31B Instruct",
          "cost": {
            "input": 0.09,
            "output": 0.34
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 256000,
            "output": 16384
          }
        }
      }
    }
  }
}
