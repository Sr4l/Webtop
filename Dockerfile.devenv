FROM ubuntu-kde-base

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND noninteractive

# Update system
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get dist-upgrade -y && \
    apt-get clean

# Set the working directory in the container to /app
# RUN useradd -ms /bin/bash user && usermod -aG sudo user && echo "user:userpw" | chpasswd

# install useful os stuff
RUN apt-get install -y curl wget ca-certificates gnupg bash-completion vim nano ansible git git-lfs make zsh sudo htop btop

# python dev env
RUN apt-get install -y python3 python3-dev python3-pip python3-venv python3-tk python3-pyqt6 \
    python3-flask python3-requests mypy python3-pytest python3-numpy python3-pandas \
    python3-matplotlib python3-scipy
RUN python3 -m pip install --break-system-packages uv ruff

# C++ and rust dev env
RUN apt-get install -y build-essential clang rust-all cmake ninja-build wget curl

# JS dev env (global, we have nodesource.list to have newer versions than debian)
RUN apt-get install -y nodejs npm
RUN npm install -g typescript esbuild

# install vscode
RUN wget -qO- https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /usr/share/keyrings/microsoft.gpg
COPY vscode.sources /etc/apt/sources.list.d/vscode.sources
RUN apt-get update && apt-get install -y code
RUN sed -i 's/Exec=code /Exec=code --no-sandbox /g' /usr/share/applications/code.desktop

# install some desktop apps
RUN apt-get install -y vlc gimp inkscape

#use custom bashrc
COPY bashrc /etc/skel/.bashrc

# Nice desktop defaults
# VS Code, Firefox und VLC as default apps
# RUN set -e; \
#     for mime in text/plain text/markdown application/x-shellscript; do \
#         xdg-mime default code.desktop "$mime"; \
#     done; \
#     for mime in application/pdf text/html x-scheme-handler/http x-scheme-handler/https; do \
#         xdg-mime default firefox.desktop "$mime"; \
#     done; \
#     for mime in video/mp4 video/x-matroska audio/mpeg audio/x-wav; do \
#         xdg-mime default vlc.desktop "$mime"; \
#     done


USER ubuntu
RUN git config --global credential.helper store
RUN git config --global user.name "mrt_user"
RUN git config --global user.email "noemail@mrt.uni-kassel.de"
RUN git config --global init.defaultBranch main
RUN git config --global pull.rebase false
RUN git lfs install

USER root

# Set up webtop configuration
EXPOSE 3000

# Default command provided by the base image
#CMD ["/init"]
#CMD ["tail", "-f", "/dev/null"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]