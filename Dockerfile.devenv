ARG BASE_IMAGE=sr4l/webtop-ubuntu-kde-base:latest
FROM ${BASE_IMAGE}

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Update system
RUN apt-get update && \
    apt-get dist-upgrade -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Batch 1: System tools, Python dev, C++/Rust dev, misc deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl wget ca-certificates gnupg bash-completion vim nano ansible git git-lfs make zsh sudo htop btop ffmpeg imagemagick \
    python3 python3-dev python3-pip python3-venv python3-tk python3-pyqt6 \
    python3-flask python3-requests python3-pytest python3-numpy python3-pandas \
    python3-matplotlib python3-scipy \
    build-essential clang rust-all cmake ninja-build \
    ripgrep fd-find \
    xvfb \
    && export POLICY_FILE=$(find /etc/ImageMagick* -name policy.xml | head -n 1) \
    && sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' "$POLICY_FILE" \
    && python3 -m pip install --break-system-packages --no-cache-dir uv ruff ty \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Batch 1.5: LaTeX - Beamer presentations with TikZ, pgfplots, and German support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    texlive texlive-latex-recommended texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-pictures \
    texlive-lang-german \
    latexmk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Batch 2: JS dev, VS Code, browsers, desktop apps
RUN apt-get update && \
    apt-get install -y --no-install-recommends nodejs npm \
    && npm install -g typescript esbuild @earendil-works/pi-coding-agent @opencode/cli \
    && npm cache clean --force \
    && wget -qO- https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY configs/vscode.sources /etc/apt/sources.list.d/vscode.sources

RUN apt-get update && \
    apt-get install -y code \
    && sed -i 's/Exec=\/usr\/share\/code\/code /Exec=\/usr\/share\/code\/code --no-sandbox /g' /usr/share/applications/com.microsoft.VSCode.desktop \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends vlc gimp inkscape libreoffice-calc libreoffice-writer software-properties-common gummi okular gwenview geany kate \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Firefox
RUN add-apt-repository -y ppa:mozillateam/ppa && \
    apt-get update && \
    apt-get install -y firefox-esr \
    && sed -i 's/Exec=firefox-esr /Exec=firefox-esr --marionette --remote-debugging-port /g' /usr/share/applications/firefox-esr.desktop \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Chrome
# WORKDIR /tmp
# RUN wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && \
#     apt-get install -y ./google-chrome-stable_current_amd64.deb && \
#     rm google-chrome-stable_current_amd64.deb && \
#     sed -i 's/Exec=\/usr\/bin\/google-chrome-stable /Exec=\/usr\/bin\/google-chrome-stable --no-sandbox /g' /usr/share/applications/google-chrome.desktop && \
#     apt-get clean && \
#     rm -rf /var/lib/apt/lists/*

USER ubuntu
WORKDIR /home/ubuntu
COPY configs/bashrc .bashrc

RUN git config --global credential.helper store && \
    git config --global user.name "mrt_user" && \
    git config --global user.email "noemail@mrt.uni-kassel.de" && \
    git config --global init.defaultBranch main && \
    git config --global pull.rebase false && \
    git lfs install

RUN code --install-extension h5web.vscode-h5web && \
    code --install-extension mechatroner.rainbow-csv && \
    code --install-extension streetsidesoftware.code-spell-checker-german && \
    code --install-extension redhat.vscode-yaml && \
    code --install-extension redhat.vscode-xml && \
    code --install-extension ms-vscode.cpptools && \
    code --install-extension ms-python.python && \
    code --install-extension ms-toolsai.jupyter && \
    code --install-extension charliermarsh.ruff && \
    code --install-extension saoudrizwan.claude-dev

WORKDIR /home/ubuntu/.local/share/konsole
COPY ["configs/Profile 1.profile", "Profile 1.profile"]

WORKDIR /home/ubuntu/.config/opencode
COPY configs/opencode.jsonc opencode.jsonc

WORKDIR /home/ubuntu/.vscode
COPY configs/argv.json argv.json

WORKDIR /home/ubuntu/.pi/agent
COPY configs/models.json models.json

WORKDIR /home/ubuntu/

COPY tasks tasks

USER root
RUN chown -R ubuntu:ubuntu /home/ubuntu

# Set up webtop configuration
EXPOSE 3000

# Default command provided by the base image
#CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]